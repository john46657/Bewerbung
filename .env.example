# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Optional: nur nötig, wenn der Bot schon vor dem Mehr-Server-Update lief und jetzt auf mehreren Servern ist.
# Die alten /einstellungen-Änderungen werden dann diesem Server zugeordnet.
GUILD_ID=

# ---------- Dashboard (optional) ----------
# Adresse, unter der das Dashboard erreichbar ist – ohne / am Ende, z. B. https://dashboard.deine-domain.de
DASHBOARD_URL=
# Developer Portal -> OAuth2 -> Client Secret (Reset Secret). Niemals teilen!
DISCORD_CLIENT_SECRET=
# Port, auf dem das Dashboard lauscht. Leer = SERVER_PORT des Hosters, sonst 3000.
DASHBOARD_PORT=
